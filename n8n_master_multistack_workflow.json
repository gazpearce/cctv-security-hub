      "parameters": {
        "functionCode": "// Formulate Multi-Stack Trade Entities under Rule 45 Google Shield\nconst payload = $input.item.json;\nconst topic = payload.topic || 'UK Physical Security & Telecoms Engineering';\nconst cleanSlug = topic.toLowerCase().replace(/[^a-z0-9]+/g, '-');\n\nlet shieldAnchor = 'https://tvandhomesecurity.blogspot.com/';\nif (cleanSlug.includes('starlink')) {\n  shieldAnchor = 'https://adicommunications.co.uk/news/starlink-chimney-mount-vs-roof-apex/';\n} else if (cleanSlug.includes('ajax')) {\n  shieldAnchor = 'https://adicommunications.co.uk/news/ajax-wireless-alarm-grade-2-installation/';\n} else if (cleanSlug.includes('ethernet') || cleanSlug.includes('cat6')) {\n  shieldAnchor = 'https://adicommunications.co.uk/news/how-to-get-ethernet-upstairs-without-running-cables/';\n} else if (cleanSlug.includes('tv') || cleanSlug.includes('fireplace')) {\n  shieldAnchor = 'https://adicommunications.co.uk/news/tv-above-fireplace-safe-installation/';\n}\n\nreturn {\n  topic,\n  cleanSlug,\n  shieldAnchor,\n  engineer: 'Gary Pearce',\n  telephone: '07860 244 274',\n  insurance: '£10,000,000 Public Liability',\n  experience_years: 25,\n  google_drive_folder: '1jkTPHdni9Bki3kwNbna5d5oK2ejPJf88',\n  youtube_channel: '@CCTV.services',\n  firebase_edge_hub: 'https://gary-pearce-forensic-hub.web.app/'\n};"
      },
